\begin_layout Subsection
Two-layer feedforward network with N neurons to one output 
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
p_{i}^{\mu}=\begin{cases}
1 & w.p.\;f\\
0 & w.p.\;(1-f)
\end{cases}
\]

\end_inset


\begin_inset Formula 
\[
q^{\mu}=\begin{cases}
1 & w.p.\;f\\
0 & w.p.\;(1-f)
\end{cases}
\]

\end_inset


\begin_inset Formula 
\[
w_{j}=\frac{1}{f(1-f)N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)\;,\;s=H(h-\theta)\;,\;h=\sum_{j=1}^{N}w_{j}r_{j}
\]

\end_inset

We have P patterens (
\begin_inset Formula $\mu=1,...,P$
\end_inset

), and for some 
\begin_inset Formula $i$
\end_inset

 we have 
\begin_inset Formula $r_{i}=p_{i}^{1}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
a.
 
\begin_inset Formula $\theta$
\end_inset

 For which 
\begin_inset Formula $P(s=1|q^{1}=0)=P(s=0|q^{1}=1)$
\end_inset


\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\begin{align*}
h=\sum_{j=1}^{N}w_{j}r_{j} & =\sum_{j=1}^{N}r_{j}\frac{1}{f(1-f)N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)r_{j}\\
= & \frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\left[\sum_{\mu=1}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]
\end{align*}

\end_inset

Now we want the expected value of h:
\begin_inset Formula 
\begin{align*}
E[h|p^{1},q^{1}] & =E\left[\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\right]\\
= & \frac{1}{f(1-f)N}E\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}(q^{1}-f)E\left[(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\sum_{j=1}^{N}E\left[p_{j}^{1}p_{j}^{1}-fp_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\sum_{j=1}^{N}E\left[\left(1-f\right)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\left(1-f\right)fN+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]E\left[q^{\mu}-f\right]E\left[p_{j}^{\mu}-f\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]\cdot0\cdot0\\
= & q^{1}-f
\end{align*}

\end_inset

Now, for 
\begin_inset Formula $q^{1}=1$
\end_inset

 we get: 
\begin_inset Formula 
\[
h=\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(1-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]
\]

\end_inset


\begin_inset Formula 
\begin{align*}
E[h|p^{1},q^{1}=1] & =E\left[\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(1-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\right]\\
= & \frac{1}{f(1-f)N}E\left[\sum_{j=1}^{N}(1-f)(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}(1-f)E\left[(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{fN}\sum_{j=1}^{N}E\left[p_{j}^{1}p_{j}^{1}-fp_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{fN}\sum_{j=1}^{N}E\left[\left(1-f\right)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{\left(1-f\right)}{fN}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{\left(1-f\right)}{fN}Nf+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(1-f\right)+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(1-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(1-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(1-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]E\left[q^{\mu}-f\right]E\left[p_{j}^{\mu}-f\right]\\
= & \left(1-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]\cdot0\cdot0\\
= & 1-f
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
Var[h|p^{1},q^{1} & =1]=Var\left[\frac{1}{f(1-f)N}\sum_{j=1}^{N}(1-f)(p_{j}^{1}-f)p_{j}^{1}+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & Var\left[\frac{1}{f(1-f)N}\sum_{j=1}^{N}(1-f)(p_{j}^{1}-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & Var\left[\frac{(1-f)}{f(1-f)N}\sum_{j=1}^{N}(p_{j}^{1}-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{1}{fN}\right)^{2}\sum_{j=1}^{N}Var\left[(1-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{1}{fN}\right)^{2}N(1-f)^{2}Var\left[p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & 0+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & 0+\left(\frac{1}{f(1-f)N}\right)^{2}(P-1)\sum_{j=1}^{N}\left(p_{j}^{1}\right)^{2}Var\left[(p_{j}^{\mu}-f)\right]Var\left[(p_{j}^{\mu}-f)\right]\\
= & \left(\frac{1}{N}\right)^{2}(P-1)\sum_{j=1}^{N}\left(p_{j}^{1}\right)^{2}\\
= & \left(\frac{1}{N}\right)^{2}(P-1)\sum_{j=1}^{N}p_{j}^{1}\\
= & \frac{(P-1)f}{N}\approx\frac{Pf}{N}
\end{align*}

\end_inset

and for 
\begin_inset Formula $q^{1}=0$
\end_inset

:
\begin_inset Formula 
\[
h=\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]
\]

\end_inset


\begin_inset Formula 
\begin{align*}
E[h|p^{1},q^{1} & =0]=E\left[\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\right]\\
= & \frac{1}{f(1-f)N}E\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}E\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}\right]+0\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}-fE\left[(p_{j}^{1}-f)p_{j}^{1}\right]\\
= & \frac{1}{(f-1)N}\sum_{j=1}^{N}E\left[(p_{j}^{1}-f)p_{j}^{1}\right]\\
= & \frac{1}{(f-1)N}\sum_{j=1}^{N}E\left[p_{j}^{1}p_{j}^{1}-fp_{j}^{1}\right]\\
= & \frac{1}{(f-1)N}\sum_{j=1}^{N}E\left[p_{j}^{1}-fp_{j}^{1}\right]\\
= & \frac{1}{(f-1)N}\sum_{j=1}^{N}(1-f)E\left[p_{j}^{1}\right]\\
= & \frac{1}{(f-1)N}N(1-f)f\\
= & -f
\end{align*}

\end_inset

Now 
\begin_inset Formula $P_{1}=P_{2}\iff E_{1}=E_{2}$
\end_inset


\begin_inset Formula 
\[
\theta=\frac{1-f-f}{2}=\frac{1-2f}{2}=\frac{1}{2}-f
\]

\end_inset


\end_layout

\begin_layout Subsubsection
b.
 Probability of an error
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
Pr^{-}=P(s\ne q^{1})\underset{1}{=}P(s=1|q^{1}=0)f+P(s=0|q^{1}=1)(1-f)\underset{2}{=}P(s=1|q^{1}=0)\underset{3}{=}P(s=0|q^{1}=1)
\]

\end_inset

Where equlity #1 is total probability and #2 and #3 are from (a).
 Now we ask what is 
\begin_inset Formula $P(s=0|q^{1}=1)$
\end_inset

 or, given that 
\begin_inset Formula $q^{1}=1$
\end_inset

, what is:
\begin_inset Formula 
\[
Pr\left[\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]<-f\right]
\]

\end_inset


\begin_inset Formula 
\[
h=\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}-f(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]
\]

\end_inset


