\begin_layout Subsection
Two-layer feedforward network with N neurons to one output 
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
p_{i}^{\mu}=\begin{cases}
1 & w.p.\;f\\
0 & w.p.\;(1-f)
\end{cases}
\]

\end_inset


\begin_inset Formula 
\[
q^{\mu}=\begin{cases}
1 & w.p.\;f\\
0 & w.p.\;(1-f)
\end{cases}
\]

\end_inset


\begin_inset Formula 
\[
w_{j}=\frac{1}{f(1-f)N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)\;,\;s=H(h-\theta)\;,\;h=\sum_{j=1}^{N}w_{j}r_{j}
\]

\end_inset

We have P patterns (
\begin_inset Formula $\mu=1,...,P$
\end_inset

), and for some 
\begin_inset Formula $i$
\end_inset

 we have 
\begin_inset Formula $r_{i}=p_{i}^{1}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
a.
 
\begin_inset Formula $\theta$
\end_inset

 For which 
\begin_inset Formula $P(s=1|q^{1}=0)=P(s=0|q^{1}=1)$
\end_inset


\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\begin{align*}
h=\sum_{j=1}^{N}w_{j}r_{j} & =\sum_{j=1}^{N}r_{j}\frac{1}{f(1-f)N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)r_{j}\\
= & \frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}\sum_{\mu=1}^{P}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\left[\sum_{\mu=1}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]
\end{align*}

\end_inset

Now we want the expected value of h:
\begin_inset Formula 
\begin{align*}
E[h|p^{1},q^{1}] & =E\left[\frac{1}{f(1-f)N}\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}+\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\right]\\
= & \frac{1}{f(1-f)N}E\left[\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{1}{f(1-f)N}\sum_{j=1}^{N}(q^{1}-f)E\left[(p_{j}^{1}-f)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\sum_{j=1}^{N}E\left[p_{j}^{1}p_{j}^{1}-fp_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\sum_{j=1}^{N}E\left[\left(1-f\right)p_{j}^{1}\right]+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \frac{(q^{1}-f)}{f(1-f)N}\left(1-f\right)fN+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}E\left[\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}p_{j}^{1}E\left[(q^{\mu}-f)(p_{j}^{\mu}-f)\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]E\left[q^{\mu}-f\right]E\left[p_{j}^{\mu}-f\right]\\
= & \left(q^{1}-f\right)+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}E\left[p_{j}^{1}\right]\cdot0\cdot0\\
= & q^{1}-f
\end{align*}

\end_inset

In conclusion - 
\begin_inset Formula $E[h|p^{1},q^{1}=1]=1-f$
\end_inset

 and 
\begin_inset Formula $E[h|p^{1},q^{1}=0]=-f$
\end_inset

.
 
\end_layout

\begin_layout Paragraph
Now we look at the variance:
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\begin{align*}
Var[h|p^{1},q^{1}] & =Var\left[\frac{1}{f(1-f)N}\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}+\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & Var\left[\frac{1}{f(1-f)N}\sum_{j=1}^{N}(q^{1}-f)(p_{j}^{1}-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & Var\left[\frac{(q^{1}-f)}{f(1-f)N}\sum_{j=1}^{N}(p_{j}^{1}-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{(q^{1}-f)}{f(1-f)N}\right)^{2}\sum_{j=1}^{N}Var\left[(1-f)p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{(q^{1}-f)}{f(1-f)N}\right)^{2}N(1-f)^{2}Var\left[p_{j}^{1}\right]+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{(q^{1}-f)}{f(1-f)N}\right)^{2}N(1-f)^{2}\cdot0+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & 0+Var\left[\frac{1}{f(1-f)N}\sum_{\mu=2}^{P}\sum_{j=1}^{N}(q^{\mu}-f)(p_{j}^{\mu}-f)p_{j}^{1}\right]\\
= & \left(\frac{1}{f(1-f)N}\right)^{2}(P-1)\sum_{j=1}^{N}\left(p_{j}^{1}\right)^{2}Var\left[(p_{j}^{\mu}-f)\right]Var\left[(p_{j}^{\mu}-f)\right]\\
= & \left(\frac{1}{N}\right)^{2}(P-1)\sum_{j=1}^{N}\left(p_{j}^{1}\right)^{2}\\
= & \left(\frac{1}{N}\right)^{2}(P-1)\sum_{j=1}^{N}p_{j}^{1}\\
= & \frac{(P-1)f}{N}\approx\frac{Pf}{N}
\end{align*}

\end_inset

I.e.
 
\begin_inset Formula $Var[h|p^{1},q^{1}=0]=Var[h|p^{1},q^{1}=1]=\frac{Pf}{N}$
\end_inset

.
 Now we want to choose 
\begin_inset Formula $\theta$
\end_inset

 such that it's the average of 
\begin_inset Formula $E[h|p^{1},q^{1}=0]$
\end_inset

 and 
\begin_inset Formula $E[h|p^{1},q^{1}=1]$
\end_inset

 and as they have the same variance, on average, the amount of times falling
 to the right of it in one condition is the same as falling left to it in
 the other so:
\begin_inset Newline newline
\end_inset

 
\begin_inset Box Boxed
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "80col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "yellow"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\[
\theta=\frac{1-f-f}{2}=\frac{1-2f}{2}=\frac{1}{2}-f
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsubsection
b.
 Probability of an error
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
Pr^{-}=P(s\ne q^{1})\underset{1}{=}P(s=1|q^{1}=0)f+P(s=0|q^{1}=1)(1-f)\underset{2}{=}P(s=1|q^{1}=0)\underset{3}{=}P(s=0|q^{1}=1)
\]

\end_inset

Where equality #1 is total probability and #2 and #3 are from (a).
 Now we ask what is 
\begin_inset Formula $P(s=0|q^{1}=1)$
\end_inset

 or, given that 
\begin_inset Formula $q^{1}=1$
\end_inset

, what is:
\begin_inset Formula 
\[
Pr\left[\theta<h|q^{1}=1\right]=?
\]

\end_inset

From article a we know 
\begin_inset Formula $h$
\end_inset

is normally distributed:
\begin_inset Formula 
\[
h\sim N\left(q^{1}-f,\frac{Pf}{N}\right)=N\left(\mu,\sigma^{2}\right)
\]

\end_inset

And so:
\begin_inset Formula 
\[
Pr\left[\theta<h|q^{1}=1\right]=\int_{-\infty}^{\frac{\theta-\mu}{\sigma}}\frac{exp\left(-z^{2}\right)}{\sqrt{2\pi}}dz
\]

\end_inset

 As 
\begin_inset Formula 
\[
\frac{\theta-\mu}{\sigma}=\frac{\frac{1}{2}-f-1+f}{\sqrt{\frac{Pf}{N}}}=-\frac{1}{2}\sqrt{\frac{N}{Pf}}=-\sqrt{\frac{N}{4Pf}}
\]

\end_inset

We get:
\begin_inset Newline newline
\end_inset


\begin_inset Box Boxed
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "80col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "yellow"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\[
Pr^{-}=P(s\ne q^{1})=\int_{-\infty}^{-\sqrt{\frac{N}{4Pf}}}\frac{exp\left(\frac{-z^{2}}{2}\right)}{\sqrt{2\pi}}dz
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsubsection
Plug in 
\begin_inset Formula $N,P$
\end_inset

 and 
\begin_inset Formula $f$
\end_inset


\end_layout

\begin_layout Paragraph
for 
\begin_inset Formula $N=400,\;P=1000$
\end_inset

 and 
\begin_inset Formula $f=0.1$
\end_inset

 we get 
\begin_inset Formula 
\[
\frac{\theta-\mu}{\sigma}=-\sqrt{\frac{N}{4Pf}}=-\sqrt{\frac{400}{4\cdot1000\cdot0.1}}=-1
\]

\end_inset

And according to the table we have:
\begin_inset Newline newline
\end_inset


\end_layout

\begin_layout Paragraph
\begin_inset Box Boxed
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "80col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "yellow"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\[
Pr^{-}=P(s\ne q^{1})=\int_{-\infty}^{-1}\frac{exp\left(-z^{2}\right)}{\sqrt{2\pi}}dz=0.16
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsection
𝑀 copies of the feedforward network
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
s^{(k)}=H\left(\sum_{j=1}^{N}w_{j}^{(k)}r_{j}^{(k)}-\theta\right)
\]

\end_inset


\begin_inset Formula 
\[
w_{j}^{(k)}=\frac{1}{f(1-f)N}\sum_{\mu=1}^{P}(q^{\mu(k)}-f)(p_{j}^{\mu(k)}-f)
\]

\end_inset


\begin_inset Formula 
\[
s^{out}=H\left(\frac{1}{M}\sum_{j=1}^{M}s^{(k)}-\theta^{out}\right)=H\left(h^{out}-\theta^{out}\right)
\]

\end_inset


\end_layout

\begin_layout Subsubsection

\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\strikeout off
\xout off
\uuline off
\uwave off
\noun off
\color none
Find 
\begin_inset Formula $Pr_{out}^{-}$
\end_inset

 
\end_layout

\begin_layout Paragraph
The probabilty for 
\begin_inset Formula $s^{(k)}=0$
\end_inset

 is the probabilty for 
\begin_inset Formula $h^{(k)}<\theta$
\end_inset

 and so:
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
s^{(k)}=\begin{cases}
0 & Pr^{-}\\
1 & 1-Pr^{-}
\end{cases}
\]

\end_inset

Now:
\begin_inset Formula 
\[
E[h^{out}]=E\left[\frac{1}{M}\sum_{j=1}^{M}s^{(k)}\right]=\frac{1}{M}\sum_{j=1}^{M}E\left[s^{(k)}\right]=\frac{1}{M}ME\left[s^{(k)}\right]=E\left[s^{(k)}\right]
\]

\end_inset


\end_layout

