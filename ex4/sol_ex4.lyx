\begin_layout Section
Analytical Exercise: Ring model with a complex input 
\end_layout

\begin_layout Paragraph
For 
\begin_inset Formula $i=0,...,N-1$
\end_inset

: 
\begin_inset Formula $\theta_{i}=\frac{s\pi i}{N}$
\end_inset

.
 
\begin_inset Formula $\tilde{J}_{ij}=\frac{1}{N}\tilde{J}(\theta_{i}-\theta_{j})$
\end_inset

.
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\begin{align*}
\frac{dr_{i}(t)}{dt}=-r_{i}(t)+\sum J_{ij}r_{j}+h_{i}\\
h_{i}=\begin{cases}
2 & |\pi-\theta_{i}|>\frac{\pi}{2}\\
0 & else
\end{cases}\\
\tilde{J}(\theta)=\begin{cases}
J & |\theta|<\frac{\pi}{2}\;or\;\frac{3\pi}{2}<|\theta|\\
0 & else
\end{cases}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
\begin_inset Formula $N\rightarrow\infty$
\end_inset


\end_layout

\begin_layout Paragraph
Just as we did in class, we write in matrix notation the continues some
 over the ring (from 
\begin_inset Formula $-\pi$
\end_inset

 to 
\begin_inset Formula $\pi$
\end_inset

):
\end_layout

\begin_layout Paragraph
\begin_inset Formula 
\[
\dot{r}(t,\theta)=-r(\theta,t)+\frac{1}{2\pi}\int_{-\pi}^{\pi}\tilde{J}(\theta-\varphi)r(\theta,t)d\varphi+h(\theta,t)
\]

\end_inset


\end_layout

\begin_layout Subsection
Fourier decomposition of 
\begin_inset Formula $r$
\end_inset

 and 
\begin_inset Formula $h$
\end_inset


\end_layout

\begin_layout Paragraph
Using chapter #3, eq- 3.12-18, First:
\begin_inset Formula 
\[
r(\theta,t)=\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\theta)+b_{n}(t)sin(n\theta)\right]
\]

\end_inset

Where:
\begin_inset Formula 
\begin{align*}
a_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)cos(n\theta)d\theta & \;\;\;\& & b_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)sin(n\theta)d\theta
\end{align*}

\end_inset

And so, as the components are decoupled, we differentiate with respect to
 the time variable:
\begin_inset Formula 
\begin{align*}
\dot{a}_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}\dot{r}(\theta,t)cos(n\theta)d\theta=\frac{1}{\pi}\int_{-\pi}^{\pi}\left[-r(\theta,t)cos(n\theta)+h(\theta,t)cos(n\theta)\right]d\theta=-a_{n}+\frac{1}{\pi}\int_{-\pi}^{\pi}h(\theta,t)cos(n\theta)d\theta\\
\dot{b}_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}\dot{r}(\theta,t)sin(n\theta)d\theta=-b_{n}+\frac{1}{\pi}\int_{-\pi}^{\pi}h(\theta,t)sin(n\theta)d\theta
\end{align*}

\end_inset


\end_layout

\begin_layout Paragraph
As for 
\begin_inset Formula $h$
\end_inset

, note that:
\begin_inset Formula 
\[
h_{i}(\theta)=1+\begin{cases}
-1 & -\pi<\theta<-\frac{\pi}{2}\\
1 & -\frac{\pi}{2}<\theta<\frac{\pi}{2}\\
-1 & \frac{\pi}{2}<\theta<\pi
\end{cases}=1+f(\theta)
\]

\end_inset

for 
\begin_inset Formula $f(\theta)$
\end_inset

 from exercise #2, question 1.1.
 As we've seen its Fourier decomposition, we can write:
\begin_inset Formula 
\[
h_{i}(\theta)=1+\frac{4}{\pi n}\left(\sum_{n=1,5,9,...}cos(nx)-\sum_{n=3,7,11,...}cos(nx)\right)=
\]

\end_inset


\end_layout

