\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\frac{\dot{a_{0}}}{2} & =\frac{\left(J-2\right)a_{0}+4}{4}\Longrightarrow\dot{a_{0}}=\frac{\left(J-2\right)a_{0}+4}{2}=a_{0}\left(\frac{J}{2}-1\right)+2\\
\dot{a_{n}}= & \left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)a_{n}+\frac{4}{\pi n}sin(\frac{n\pi}{2})\\
\dot{b_{n}}= & \left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)b_{n}
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsection
Fixed point analysis
\end_layout

\begin_layout Paragraph
We want to find when 
\begin_inset Formula $\dot{a_{0}}=\dot{a_{n}}=\dot{b_{n}}=0$
\end_inset

:
\begin_inset Newline newline
\end_inset


\begin_inset Box Boxed
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "yellow"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\[
\begin{cases}
0\overset{!}{=}\frac{\dot{a_{0}}}{2}=a_{0}\left(\frac{J}{2}-1\right)+2\Longrightarrow & a_{0}^{*}=-\frac{2}{\left(\frac{J}{2}-1\right)}=\frac{-4}{J-2}=\frac{4}{2-J}\\
0\overset{!}{=}\dot{a_{n}}=\left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)a_{n}+\frac{4}{\pi n}sin(\frac{n\pi}{2})\Longrightarrow & a_{n}^{*}=\frac{\frac{4}{\pi n}sin(\frac{n\pi}{2})}{\left(1-\frac{J}{\pi n}sin(\frac{n\pi}{2})\right)}=\frac{4sin(\frac{n\pi}{2})}{\pi n-Jsin(\frac{n\pi}{2})}\\
0\overset{!}{=}\dot{b_{n}}=\left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)b_{n}\Longrightarrow & b_{n}^{*}=0
\end{cases}
\]

\end_inset


\end_layout

\end_inset


\begin_inset Newline newline
\end_inset

Note that if 
\begin_inset Formula $\frac{J}{\pi n}sin(\frac{n\pi}{2})=1$
\end_inset

 then we can have 
\begin_inset Formula $b_{n}^{*}\ne0$
\end_inset

.
 This is iff 
\begin_inset Formula $sin(\frac{n\pi}{2})=\frac{\pi n}{J}$
\end_inset

 and may only hold for a single n (
\begin_inset Formula $=_{mod_{4}}1$
\end_inset

) and a suitable 
\begin_inset Formula $J$
\end_inset

.
 
\end_layout

\begin_layout Subsection
Fixed point stability
\end_layout

\begin_layout Paragraph
As 
\begin_inset Formula $b_{n}=0$
\end_inset

 at the FP's we can ignore it and only look at the eigenvalues of the linearized
 systems of 
\begin_inset Formula $a_{n}$
\end_inset

.
 As for 
\begin_inset Formula $a_{0}$
\end_inset

:
\begin_inset Formula 
\begin{align*}
\frac{d\dot{a}_{0}}{da_{0}}= & \frac{J}{2}-1<0\iff J<2
\end{align*}

\end_inset

As for 
\begin_inset Formula $a_{n}$
\end_inset

 for even n's: 
\begin_inset Formula $sin(\frac{n\pi}{2})=0$
\end_inset

 so:
\begin_inset Formula 
\[
\frac{d\dot{a}_{n}}{da_{n}}=\frac{J}{\pi n}sin(\frac{n\pi}{2})-1=-1<0
\]

\end_inset

And thus, those coefficients would converge.
 For 
\begin_inset Formula $n=3,7,11,...$
\end_inset

 we get: 
\begin_inset Formula $sin(\frac{n\pi}{2})=-1$
\end_inset

, so:
\begin_inset Formula 
\[
\frac{d\dot{a}_{n}}{da_{n}}=\frac{J}{\pi n}sin(\frac{n\pi}{2})-1=-\frac{J}{\pi n}-1<0
\]

\end_inset

as 
\begin_inset Formula $\frac{J}{\pi n}$
\end_inset

 is a positive number.
 Lastly we're left with the case when 
\begin_inset Formula $n=1,5,9,...$
\end_inset

.
 In this case 
\begin_inset Formula $sin(\frac{n\pi}{2})=1$
\end_inset

 and:
\begin_inset Formula 
\[
\frac{d\dot{a}_{n}}{da_{n}}=\frac{J}{\pi n}sin(\frac{n\pi}{2})-1=\frac{J}{\pi n}-1<0\iff\frac{J}{\pi n}<1\iff J<\pi n\iff J<\pi<5\pi<9\pi...
\]

\end_inset

So as 
\begin_inset Formula $n\rightarrow\infty$
\end_inset

, we only need to check for the case 
\begin_inset Formula $n=1$
\end_inset

 and we know the condition for bigger n's will be met.
 As we've already demanded for the 
\begin_inset Formula $a_{0}$
\end_inset

case that 
\begin_inset Formula $J<2<\pi$
\end_inset

 and the condition that 
\begin_inset Formula $\frac{d\dot{a}_{n}}{da_{n}}<0$
\end_inset

 will be satisfied.
 In conclusion, we get stable fixed points iff:
\begin_inset Newline newline
\end_inset


