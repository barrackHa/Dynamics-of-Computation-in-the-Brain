\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\dot{r}(t,\theta) & =-r(\theta,t)+\frac{1}{2\pi}\int_{-\pi}^{\pi}\tilde{J}(\theta-\varphi)r(\varphi,t)d\varphi+h(\theta,t)\\
= & -r(\theta,t)+\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\varphi,t)d\varphi+h(\theta,t)
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsection
Fourier decomposition of 
\begin_inset Formula $r$
\end_inset

 and 
\begin_inset Formula $h$
\end_inset


\end_layout

\begin_layout Paragraph
Using chapter #3, eq- 3.12-18, First:
\begin_inset Formula 
\[
r(\theta,t)=\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\theta)+b_{n}(t)sin(n\theta)\right]
\]

\end_inset

Where:
\begin_inset Formula 
\begin{align*}
a_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)cos(n\theta)d\theta & \;\;\;\& & b_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)sin(n\theta)d\theta
\end{align*}

\end_inset

Now, we differentiate with respect to the time variable:
\begin_inset Formula 
\begin{align*}
\dot{a}_{n}(t)=\frac{da_{n}}{dt} & =\frac{d}{dt}\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)cos(n\theta)d\theta=\frac{1}{\pi}\int_{-\pi}^{\pi}\frac{d}{dt}\left[r(\theta,t)cos(n\theta)\right]d\theta\\
= & \frac{1}{\pi}\int_{-\pi}^{\pi}\left[\frac{dr}{dt}(\theta,t)cos(n\theta)+r(\theta,t)\frac{dcos}{dt}(n\theta)\right]d\theta\\
\underset{1}{=} & \frac{1}{\pi}\int_{-\pi}^{\pi}\left[\dot{r}(\theta,t)cos(n\theta)+0\right]d\theta\underset{2}{=}\frac{1}{\pi}\int_{-\pi}^{\pi}\left[-r(\theta,t)cos(n\theta)+h(\theta,t)cos(n\theta)\right]d\theta\\
= & -\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)cos(n\theta)d\theta+\frac{1}{\pi}\int_{-\pi}^{\pi}h(\theta,t)cos(n\theta)d\theta\\
\underset{3}{=} & -a_{n}+\frac{1}{\pi}\int_{-\pi}^{\pi}h(\theta,t)cos(n\theta)d\theta
\end{align*}

\end_inset

Where equality #1 is due to the derivation of a product, #2 is because 
\begin_inset Formula $cos(n\theta)$
\end_inset

 does bot change with respect to time and #3 is uses the definition of the
 nth component of the Fourier decomposition of 
\begin_inset Formula $r$
\end_inset

.
 From the same exact arguments we get:
\begin_inset Formula 
\begin{align*}
\dot{b}_{n}(t)=-b_{n}+\frac{1}{\pi}\int_{-\pi}^{\pi}h(\theta,t)sin(n\theta)d\theta
\end{align*}

\end_inset

Now:
\begin_inset Formula 
\begin{align*}
\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\theta,t)d\theta & =\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}J\left[\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\theta)+b_{n}(t)sin(n\theta)\right]\right]d\theta\\
= & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\theta+\sum_{n=1}^{\infty}a_{n}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}cos(n\theta)d\theta+\sum_{n=1}^{\infty}b_{n}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}sin(n\theta)d\theta\right]\\
= & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\theta+\sum_{n=1}^{\infty}a_{n}\left.\frac{sin(nx)}{n}\right|_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}-\sum_{n=1}^{\infty}b_{n}\left.\frac{cos(nx)}{n}\right|_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\right]\\
\underset{1}{=} & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\theta+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin(\frac{n\pi}{2})\right]-\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[-2sin(n\theta)sin(\frac{n\pi}{2})\right]\right]\\
= & \frac{J}{2\pi}\left[\frac{a_{0}}{2}\left[\theta+\frac{\pi}{2}-\theta+\frac{\pi}{2}\right]+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin(\frac{n\pi}{2})\right]+\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[2sin(n\theta)sin(\frac{n\pi}{2})\right]\right]\\
= & \frac{J}{2\pi}\left[\frac{a_{0}\pi}{2}+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin(\frac{n\pi}{2})\right]+\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[2sin(n\theta)sin(\frac{n\pi}{2})\right]\right]\\
= & \frac{Ja_{0}}{4}+\frac{J}{2\pi}\sum_{n=1}^{\infty}\left[\frac{a_{n}}{n}\left[2cos(n\theta)sin(\frac{n\pi}{2})\right]+\frac{b_{n}}{n}\left[2sin(n\theta)sin(\frac{n\pi}{2})\right]\right]\\
= & \frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\frac{J}{\pi n}sin(\frac{n\pi}{2})\left[a_{n}cos(n\theta)+b_{n}sin(n\theta)\right]\\
= & \frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\frac{J}{\pi n}sin(\frac{n\pi}{2})a_{n}cos(n\theta)+\sum_{n=1}^{\infty}\frac{J}{\pi n}sin(\frac{n\pi}{2})b_{n}sin(n\theta)
\end{align*}

\end_inset


\end_layout

\begin_layout Paragraph
Where equality #1 is explained in the TA (page #5).
 Notice the integrals in the equations above are simply the nth Fourier
 components of 
\begin_inset Formula $h$
\end_inset

.
 Now:
\begin_inset Formula 
\[
h(\theta)=1+f(\theta)=1+\begin{cases}
-1 & -\pi<\theta<-\frac{\pi}{2}\\
1 & -\frac{\pi}{2}<\theta<\frac{\pi}{2}\\
-1 & \frac{\pi}{2}<\theta<\pi
\end{cases}
\]

\end_inset

for 
\begin_inset Formula $f(\theta)$
\end_inset

 from exercise #2, question 1.1.
 As we've seen its Fourier decomposition, we can write:
\begin_inset Formula 
\begin{align*}
h(\theta) & =1+\frac{4}{\pi n}\left(\sum_{n=1,5,9,...}cos(n\theta)-\sum_{n=3,7,11,...}cos(n\theta)\right)=1+\frac{4}{\pi n}\sum_{n=1,3,5,...}(-1)^{\frac{n-1}{2}}cos(n\theta)\\
= & 1+\sum_{n=1}^{\infty}\frac{4}{\pi n}sin(\frac{n\pi}{2})cos(n\theta)
\end{align*}

\end_inset

Putting it all together, we get:
\begin_inset Formula 
\begin{align*}
\dot{r} & =-r+\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\varphi)d\varphi+h(\theta)\\
= & -\frac{a_{0}}{2}-\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\theta)+b_{n}(t)sin(n\theta)\right]\\
 & +\frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\frac{J}{\pi n}sin(\frac{n\pi}{2})\left[a_{n}cos(n\theta)+b_{n}sin(n\theta)\right]\\
 & +1+\sum_{n=1}^{\infty}\frac{4}{\pi n}sin(\frac{n\pi}{2})cos(nx)\\
= & \left[-\frac{a_{0}}{2}+\frac{Ja_{0}}{4}+1\right]+\\
 & +\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin(\frac{n\pi}{2})a_{n}-a_{n}+\frac{4}{\pi n}sin(\frac{n\pi}{2})\right]cos(n\theta)\\
 & +\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin(\frac{n\pi}{2})b_{n}-b_{n}\right]sin(n\theta)\\
= & \frac{\left(J-2\right)a_{0}+4}{4}+\sum_{n=1}^{\infty}\left[\left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)a_{n}+\frac{4}{\pi n}sin(\frac{n\pi}{2})\right]cos(n\theta)+\sum_{n=1}^{\infty}\left[\left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)b_{n}\right]sin(n\theta)\\
\coloneqq & \frac{a_{0}^{\prime}}{2}+\sum_{n=1}^{\infty}a_{n}^{\prime}cos(n\theta)+\sum_{n=1}^{\infty}b_{n}^{\prime}sin(n\theta)
\end{align*}

\end_inset

Where the last transition is a definetion of a new Fourier decomposition.
 Now, We also know that:
\begin_inset Formula 
\[
\frac{dr}{dt}(\theta,t)=\dot{r}=\frac{\dot{a_{0}}}{2}+\sum_{n=1}^{\infty}\dot{a_{n}}(t)cos(n\theta)+\sum_{n=1}^{\infty}\dot{b_{n}}(t)sin(n\theta)
\]

\end_inset

From this we get:
\begin_inset Newline newline
\end_inset


\begin_inset Box Boxed
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "none"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\frac{\dot{a_{0}}}{2} & =\frac{\left(J-2\right)a_{0}+4}{4}\Longrightarrow\dot{a_{0}}=\frac{\left(J-2\right)a_{0}+4}{2}=a_{0}\left(\frac{J}{2}-1\right)+2\\
\dot{a_{n}}= & \left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)a_{n}+\frac{4}{\pi n}sin(\frac{n\pi}{2})\\
\dot{b_{n}}= & \left(\frac{J}{\pi n}sin(\frac{n\pi}{2})-1\right)b_{n}
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

