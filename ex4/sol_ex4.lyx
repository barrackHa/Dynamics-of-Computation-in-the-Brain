\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\dot{r}(t,\theta) & =-r(\theta,t)+\frac{1}{2\pi}\int_{-\pi}^{\pi}\tilde{J}(\theta-\varphi)r(\varphi,t)d\varphi+h(\theta,t)\\
= & -r(\theta,t)+\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\varphi,t)d\varphi+h(\theta,t)
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsection
Fourier decomposition of 
\begin_inset Formula $r$
\end_inset

 and 
\begin_inset Formula $h$
\end_inset


\end_layout

\begin_layout Paragraph
Using chapter #3, eq- 3.12-18, First:
\begin_inset Formula 
\[
r(\theta,t)=\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\theta)+b_{n}(t)sin(n\theta)\right]
\]

\end_inset

Where:
\begin_inset Formula 
\[
a_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)cos(n\theta)d\theta\;\;\;\&\;\;\;b_{n}(t)=\frac{1}{\pi}\int_{-\pi}^{\pi}r(\theta,t)sin(n\theta)d\theta
\]

\end_inset

We go back to the other parts of the sum in 1.1, we'll look at their Fourier
 decomposition separately as we did for 
\begin_inset Formula $r$
\end_inset

.
 Once we'll put them all together, we can compare them with the Fourier
 decomposition of 
\begin_inset Formula $\dot{r}$
\end_inset

 and get a set of decoupled dynamical equations.
 Moving on to the second member in the sum, the varying part of the input:
\begin_inset Formula 
\begin{align*}
\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\varphi,t)d\varphi & =\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}J\left[\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[a_{n}(t)cos(n\varphi)+b_{n}(t)sin(n\varphi)\right]\right]dv\theta\\
= & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\varphi+\sum_{n=1}^{\infty}a_{n}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}cos(n\varphi)d\varphi+\sum_{n=1}^{\infty}b_{n}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}sin(n\varphi)d\varphi\right]\\
= & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\varphi+\sum_{n=1}^{\infty}a_{n}\left.\frac{sin(n\varphi)}{n}\right|_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}-\sum_{n=1}^{\infty}b_{n}\left.\frac{cos(n\varphi)}{n}\right|_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\right]\\
= & \frac{J}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\varphi\\
 & +\frac{J}{2\pi}\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[sin\left(n\theta+\frac{n\pi}{2}\right)-sin\left(n\theta-\frac{n\pi}{2}\right)\right]\\
 & -\frac{J}{2\pi}\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[cos\left(n\theta+\frac{n\pi}{2}\right)-cos\left(n\theta-\frac{n\pi}{2}\right)\right]\\
\underset{1}{=} & \frac{J}{2\pi}\left[\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}\frac{a_{0}}{2}d\varphi+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin\left(\frac{n\pi}{2}\right)\right]-\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[-2sin(n\theta)sin\left(\frac{n\pi}{2}\right)\right]\right]\\
= & \frac{J}{2\pi}\left[\frac{a_{0}}{2}\left[\theta+\frac{\pi}{2}-\theta+\frac{\pi}{2}\right]+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin\left(\frac{n\pi}{2}\right)\right]+\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[2sin(n\theta)sin\left(\frac{n\pi}{2}\right)\right]\right]\\
= & \frac{J}{2\pi}\left[\frac{a_{0}\pi}{2}+\sum_{n=1}^{\infty}\frac{a_{n}}{n}\left[2cos(n\theta)sin\left(\frac{n\pi}{2}\right)\right]+\sum_{n=1}^{\infty}\frac{b_{n}}{n}\left[2sin(n\theta)sin\left(\frac{n\pi}{2}\right)\right]\right]\\
= & \frac{Ja_{0}}{4}+\frac{J}{2\pi}\sum_{n=1}^{\infty}\left[\frac{a_{n}}{n}\left[2cos(n\theta)sin\left(\frac{n\pi}{2}\right)\right]+\frac{b_{n}}{n}\left[2sin(n\theta)sin\left(\frac{n\pi}{2}\right)\right]\right]\\
= & \frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)\left[a_{n}cos(n\theta)+b_{n}sin(n\theta)\right]\\
= & \frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)a_{n}\right]cos(n\theta)+\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)b_{n}\right]sin(n\theta)
\end{align*}

\end_inset


\end_layout

\begin_layout Paragraph
Where equality #1 (explained in the TA, page #5) uses the identities:
\begin_inset Formula 
\begin{align*}
sin\left(n\theta\pm\frac{n\pi}{2}\right)=sin(n\theta)cos\left(\frac{n\pi}{2}\right)\pm sin(n\theta)cos\left(\frac{n\pi}{2}\right)\\
cos\left(n\theta\pm\frac{n\pi}{2}\right)=cos(n\theta)cos\left(\frac{n\pi}{2}\right)\mp sin(n\theta)sin\left(\frac{n\pi}{2}\right)
\end{align*}

\end_inset

And thus:
\begin_inset Formula 
\begin{align*}
sin\left(n\theta+\frac{n\pi}{2}\right)-sin\left(n\theta-\frac{n\pi}{2}\right)= & sin(n\theta)cos\left(\frac{n\pi}{2}\right)+sin(n\theta)cos\left(\frac{n\pi}{2}\right)-sin(n\theta)cos\left(\frac{n\pi}{2}\right)+sin(n\theta)cos\left(\frac{n\pi}{2}\right)\\
= & 2cos(n\theta)sin\left(\frac{n\pi}{2}\right)
\end{align*}

\end_inset

and:
\begin_inset Formula 
\begin{align*}
cos\left(n\theta+\frac{n\pi}{2}\right)-cos\left(n\theta-\frac{n\pi}{2}\right)= & cos(n\theta)cos\left(\frac{n\pi}{2}\right)-sin(n\theta)sin\left(\frac{n\pi}{2}\right)-cos(n\theta)cos\left(\frac{n\pi}{2}\right)-sin(n\theta)sin\left(\frac{n\pi}{2}\right)\\
= & -2sin(n\theta)sin\left(\frac{n\pi}{2}\right)
\end{align*}

\end_inset

We got the Fourier components of the varying part of the input.
 Now moving on to constant part of the input (note there may arise a slight
 confusion here from the notation, usually we refer to all of the neural
 input as 
\begin_inset Formula $h$
\end_inset

 but here only to the fixed external component):
\begin_inset Formula 
\[
h(\theta)=1+f(\theta)=1+\begin{cases}
-1 & -\pi<\theta<-\frac{\pi}{2}\\
1 & -\frac{\pi}{2}<\theta<\frac{\pi}{2}\\
-1 & \frac{\pi}{2}<\theta<\pi
\end{cases}
\]

\end_inset

for 
\begin_inset Formula $f(\theta)$
\end_inset

 from exercise #2, question 1.1.
 We've already calculated its Fourier decomposition:
\begin_inset Formula 
\begin{align*}
h(\theta) & =1+\frac{4}{\pi n}\left(\sum_{n=1,5,9,...}cos(n\theta)-\sum_{n=3,7,11,...}cos(n\theta)\right)=1+\frac{4}{\pi n}\sum_{n=1,3,5,...}(-1)^{\frac{n-1}{2}}cos(n\theta)\\
= & 1+\sum_{n=1}^{\infty}\left[\frac{4}{\pi n}sin(\frac{n\pi}{2})\right]cos(n\theta)=\frac{2}{2}+\sum_{n=1}^{\infty}\left[\frac{4}{\pi n}sin(\frac{n\pi}{2})\right]cos(n\theta)+\sum_{n=1}^{\infty}0\cdot sin(n\theta)
\end{align*}

\end_inset

Putting it all together, we join the coefficients of the sine, cosine and
 free members together and get:
\begin_inset Formula 
\begin{align*}
\dot{r} & =-r+\frac{1}{2\pi}\int_{\theta-\frac{\pi}{2}}^{\theta+\frac{\pi}{2}}Jr(\varphi)d\varphi+h(\theta)\\
= & -\frac{a_{0}}{2}+\sum_{n=1}^{\infty}\left[-a_{n}\right](t)cos(n\theta)+\sum_{n=1}^{\infty}\left[-b_{n}\right](t)sin(n\theta)\\
 & +\frac{Ja_{0}}{4}+\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)a_{n}\right]cos(n\theta)+\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)b_{n}\right]sin(n\theta)\\
 & +1+\sum_{n=1}^{\infty}\left[\frac{4}{\pi n}sin(\frac{n\pi}{2})\right]cos(n\theta)\\
= & \left[-\frac{a_{0}}{2}+\frac{Ja_{0}}{4}+1\right]+\\
 & +\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)a_{n}-a_{n}+\frac{4}{\pi n}sin\left(\frac{n\pi}{2}\right)\right]cos(n\theta)\\
 & +\sum_{n=1}^{\infty}\left[\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)b_{n}-b_{n}\right]sin(n\theta)\\
= & \frac{\left(J-2\right)a_{0}+4}{4}+\sum_{n=1}^{\infty}\left[\left(\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)-1\right)a_{n}+\frac{4}{\pi n}sin\left(\frac{n\pi}{2}\right)\right]cos(n\theta)+\sum_{n=1}^{\infty}\left[\left(\frac{J}{\pi n}sin\left(\frac{n\pi}{2}\right)-1\right)b_{n}\right]sin(n\theta)
\end{align*}

\end_inset

What we got defines the Fourier decomposition of 
\begin_inset Formula $\dot{r}$
\end_inset

 in the terms of 
\begin_inset Formula $a_{0},a_{n}\&b_{n}$
\end_inset

.
 Now, We also know that:
\begin_inset Formula 
\begin{align*}
\dot{r} & =\frac{dr}{dt}(\theta,t)=\frac{d}{dt}\frac{a_{0}(t)}{2}+\frac{d}{dt}\sum_{n=1}^{\infty}a_{n}(t)cos(n\theta)+\frac{d}{dt}\sum_{n=1}^{\infty}b_{n}(t)sin(n\theta)\\
= & \frac{\dot{a_{0}}}{2}+\sum_{n=1}^{\infty}\frac{d}{dt}\left(a_{n}(t)cos(n\theta)\right)+\sum_{n=1}^{\infty}\frac{d}{dt}\left(b_{n}(t)sin(n\theta)\right)\\
= & \frac{\dot{a_{0}}}{2}+\sum_{n=1}^{\infty}\left(cos(n\theta)\frac{d}{dt}a_{n}(t)+a_{n}(t)\frac{d}{dt}cos(n\theta)\right)+\sum_{n=1}^{\infty}\left(sin(n\theta)\frac{d}{dt}b_{n}(t)+b_{n}(t)\frac{d}{dt}sin(n\theta)\right)\\
= & \frac{\dot{a_{0}}}{2}+\sum_{n=1}^{\infty}\dot{a_{n}}(t)cos(n\theta)+\sum_{n=1}^{\infty}\dot{b_{n}}(t)sin(n\theta)
\end{align*}

\end_inset

Where the last equality is holds because 
\begin_inset Formula $sin(n\theta)$
\end_inset

 and 
\begin_inset Formula $cos(n\theta)$
\end_inset

 do not change with respect to time and so 
\begin_inset Formula $0=\frac{d}{dt}sin(n\theta)=\frac{d}{dt}cos(n\theta)$
\end_inset

.
 What we got is two different ways to write the Fourier decomposition of
 
\begin_inset Formula $\dot{r}$
\end_inset

.
 We can compare the coefficients element-wise (which is possible as were
 dealing with a linear combination of eigenfunctions) and get a set of decoupled
 ODE's:
\begin_inset Newline newline
\end_inset


\begin_inset Box Boxed
