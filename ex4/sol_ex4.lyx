\begin_layout Subsubsection
For a general function 
\begin_inset Formula $f$
\end_inset

 , 
\begin_inset Formula $a_{0}$
\end_inset

 is twice its average
\end_layout

\begin_layout Paragraph
By definition:
\begin_inset Formula 
\[
f_{avg}:=\frac{1}{2\pi}\int_{-\pi}^{\pi}f(x)dx=\frac{1}{2}\left(\frac{1}{\pi}\int_{-\pi}^{\pi}f(x)dx\right)=\frac{1}{2}a_{0}
\]

\end_inset


\end_layout

